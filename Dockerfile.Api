FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY SocialCareManager.Domain/SocialCareManager.Domain.csproj SocialCareManager.Domain/
COPY SocialCareManager.Infrastructure/SocialCareManager.Infrastructure.csproj SocialCareManager.Infrastructure/
COPY SocialCareManager.Api/SocialCareManager.Api.csproj SocialCareManager.Api/

RUN dotnet restore SocialCareManager.Api/SocialCareManager.Api.csproj

COPY SocialCareManager.Domain/ SocialCareManager.Domain/
COPY SocialCareManager.Infrastructure/ SocialCareManager.Infrastructure/
COPY SocialCareManager.Api/ SocialCareManager.Api/

RUN dotnet publish SocialCareManager.Api/SocialCareManager.Api.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

ENTRYPOINT ["dotnet", "SocialCareManager.Api.dll"]