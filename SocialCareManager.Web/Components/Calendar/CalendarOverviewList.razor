@using SocialCareManager.Web.Components.Common
@using SocialCareManager.Web.Dtos.Calendar

@if (Items.Count == 0)
{
    <EmptyState
        Icon="bi bi-calendar-week"
        Title="Nothing planned"
        Description="There are no activities or medication doses in this period."
        ShowButton="false" />
}
else
{
    @foreach (var dayGroup in Items
        .OrderBy(x => x.StartAt)
        .GroupBy(x => x.StartAt.ToLocalTime().Date))
    {
        <div class="mb-4">
            <h5 class="border-bottom pb-2">
                @GetDayHeading(dayGroup.Key)
            </h5>

            @foreach (var item in dayGroup)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="d-flex gap-3">
                                <div class="fs-4">
                                    <i class="@GetSourceIcon(item.Source)"></i>
                                </div>

                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="fw-semibold">
                                            @item.Title
                                        </span>

                                        <span class="badge @GetSourceClass(item.Source)">
                                            @item.TypeText
                                        </span>

                                        <span class="badge @GetStatusClass(item)">
                                            @item.StatusText
                                        </span>

                                        @if (item.RequiresAttention)
                                        {
                                            <span class="badge bg-danger">
                                                Needs attention
                                            </span>
                                        }
                                    </div>

                                    <div class="text-muted mt-1">
                                        @GetTimeText(item)
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Location))
                                    {
                                        <div class="small mt-1">
                                            <i class="bi bi-geo-alt"></i>
                                            @item.Location
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.ResponsiblePerson))
                                    {
                                        <div class="small mt-1">
                                            <i class="bi bi-person"></i>
                                            @item.ResponsiblePerson
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="small text-muted mt-2">
                                            @item.Description
                                        </div>
                                    }
                                </div>
                            </div>

                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OnOpen.InvokeAsync(item)">
                                Open
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter]
    public List<CalendarOverviewItemDto> Items { get; set; } = new();

    [Parameter]
    public EventCallback<CalendarOverviewItemDto> OnOpen { get; set; }

    private static string GetDayHeading(DateTime date)
    {
        if (date == DateTime.Today)
            return $"Today · {date:yyyy-MM-dd}";

        if (date == DateTime.Today.AddDays(1))
            return $"Tomorrow · {date:yyyy-MM-dd}";

        return date.ToString("dddd · yyyy-MM-dd");
    }

    private static string GetTimeText(CalendarOverviewItemDto item)
    {
        if (item.IsAllDay)
            return "All day";

        var start = item.StartAt.ToLocalTime();

        if (!item.EndAt.HasValue)
            return start.ToString("HH:mm");

        var end = item.EndAt.Value.ToLocalTime();

        if (start.Date == end.Date)
            return $"{start:HH:mm}–{end:HH:mm}";

        return $"{start:yyyy-MM-dd HH:mm} – {end:yyyy-MM-dd HH:mm}";
    }

    private static string GetSourceIcon(CalendarItemSource source)
    {
        return source switch
        {
            CalendarItemSource.MedicationDose => "bi bi-capsule",
            CalendarItemSource.CarePlanReview => "bi bi-clipboard2-check",
            _ => "bi bi-calendar-event"
        };
    }

    private static string GetSourceClass(CalendarItemSource source)
    {
        return source switch
        {
            CalendarItemSource.MedicationDose => "bg-info text-dark",
            CalendarItemSource.CarePlanReview => "bg-warning text-dark",
            _ => "bg-primary"
        };
    }

    private static string GetStatusClass(CalendarOverviewItemDto item)
    {
        if (item.RequiresAttention)
            return "bg-danger";

        return item.StatusText switch
        {
            
            "Completed" => "bg-success",
            "Given" => "bg-success",
            "Cancelled" => "bg-secondary",
            "Refused" => "bg-danger",
            "Not given" => "bg-danger",
            "Not available" => "bg-dark",
            "Delayed" => "bg-warning text-dark",
            "Waiting" => "bg-primary",
            "Scheduled" => "bg-primary",
            "Overdue" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}