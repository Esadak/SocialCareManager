<div class="text-center py-5">

    <i class="@Icon display-4 text-secondary"></i>

    <h4 class="mt-3">@Title</h4>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="text-muted">
            @Description
        </p>
    }

    @if (ShowButton && !string.IsNullOrWhiteSpace(ButtonText))
    {
        <button class="btn btn-primary mt-2" @onclick="OnButtonClick">
            @if (!string.IsNullOrWhiteSpace(ButtonIcon))
            {
                <i class="@ButtonIcon"></i>
            }

            @ButtonText
        </button>
    }

</div>

@code {

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Description { get; set; } = "";

    [Parameter]
    public string Icon { get; set; } = "bi bi-inbox";

    [Parameter]
    public bool ShowButton { get; set; }

    [Parameter]
    public string ButtonText { get; set; } = "";

    [Parameter]
    public string ButtonIcon { get; set; } = "bi bi-plus-circle";

    [Parameter]
    public EventCallback OnButtonClick { get; set; }
}