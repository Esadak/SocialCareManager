@page "/"
@rendermode InteractiveServer

@using SocialCareManager.Web.Dtos.Dashboard
@using SocialCareManager.Web.Services
@using SocialCareManager.Web.Services.Api
@using SocialCareManager.Web.Components.Dashboard

@inject DashboardService DashboardService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

@if (!AuthService.IsLoggedIn)
{
    <div class="alert alert-warning">
        Please sign in to access the dashboard.
    </div>

    <a class="btn btn-primary" href="/login">
        Go to login
    </a>
}
else
{
    <div class="dashboard-header mb-4">
        <div>
            <h1 class="dashboard-title">
                <i class="bi bi-speedometer2 me-2"></i>
                Dashboard
            </h1>

            <p class="dashboard-subtitle">
                Important information and actions across the care service.
            </p>
        </div>

        <button class="btn btn-outline-primary"
                @onclick="RefreshAsync"
                disabled="@isLoading">
            <i class="bi bi-arrow-clockwise"></i>
            @(isLoading ? "Refreshing..." : "Refresh")
        </button>
    </div>

    <div class="mb-4">
        <span class="text-muted">Signed in as</span>
        <strong class="ms-1">
            @(string.IsNullOrWhiteSpace(AuthService.Email)
                ? "Unknown user"
                : AuthService.Email)
        </strong>

        @if (!string.IsNullOrWhiteSpace(AuthService.Role))
        {
            <span class="badge bg-primary ms-2">
                @AuthService.Role
            </span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-2"></i>
            @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="card p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="spinner-border text-primary"
                     role="status">
                </div>

                <div>
                    <strong>Loading dashboard</strong>
                    <div class="text-muted">
                        Collecting current information.
                    </div>
                </div>
            </div>
        </div>
    }
    else if (insights is not null)
    {
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="mb-1">Overview</h3>

                    <p class="text-muted mb-0">
                        Current totals across the system.
                    </p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6 col-xl-3">
                    <button class="dashboard-stat-card"
                            @onclick="OpenServiceUsers">
                        <div class="dashboard-stat-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>

                        <div>
                            <div class="dashboard-stat-label">
                                Service users
                            </div>

                            <div class="dashboard-stat-value">
                                @insights.TotalServiceUsers
                            </div>
                        </div>
                    </button>
                </div>

                <div class="col-md-6 col-xl-3">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-icon">
                            <i class="bi bi-clipboard2-check-fill"></i>
                        </div>

                        <div>
                            <div class="dashboard-stat-label">
                                Active care plans
                            </div>

                            <div class="dashboard-stat-value">
                                @insights.ActiveCarePlans
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-3">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-icon">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>

                        <div>
                            <div class="dashboard-stat-label">
                                Open incidents
                            </div>

                            <div class="dashboard-stat-value">
                                @insights.OpenIncidents
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-3">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-icon">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>

                        <div>
                            <div class="dashboard-stat-label">
                                Events today
                            </div>

                            <div class="dashboard-stat-value">
                                @insights.CalendarToday
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <div class="mb-3">
                <h3 class="mb-1">Needs attention</h3>

                <p class="text-muted mb-0">
                    Records and activities that may require follow-up.
                </p>
            </div>

            @if (TotalAttentionItems == 0)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    No urgent issues require attention.
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Care plans overdue"
                            Value="@insights.CarePlansOverdue"
                            Description="Active plans with a review date that has passed."
                            Icon="bi bi-clipboard-x"
                            Severity="@GetSeverity(insights.CarePlansOverdue)"
                            OnOpen="OpenServiceUsers" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Care plans due soon"
                            Value="@insights.CarePlansDueSoon"
                            Description="Care plans due for review within seven days."
                            Icon="bi bi-calendar2-week"
                            Severity="@GetWarningSeverity(insights.CarePlansDueSoon)"
                            OnOpen="OpenServiceUsers" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Medication doses waiting"
                            Value="@insights.MedicationWaiting"
                            Description="Medication doses that have not yet been recorded."
                            Icon="bi bi-capsule"
                            Severity="@GetSeverity(insights.MedicationWaiting)"
                            OnOpen="OpenServiceUsers" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Medication not given"
                            Value="@insights.MedicationMissed"
                            Description="Refused, omitted or unavailable medication doses."
                            Icon="bi bi-capsule-pill"
                            Severity="@GetSeverity(insights.MedicationMissed)"
                            OnOpen="OpenServiceUsers" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="High-severity incidents"
                            Value="@insights.HighSeverityIncidents"
                            Description="Open incidents marked high or critical."
                            Icon="bi bi-exclamation-octagon-fill"
                            Severity="@GetSeverity(insights.HighSeverityIncidents)"
                            OnOpen="OpenServiceUsers" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Calendar events overdue"
                            Value="@insights.CalendarOverdue"
                            Description="Scheduled activities whose end time has passed."
                            Icon="bi bi-calendar-x"
                            Severity="@GetSeverity(insights.CalendarOverdue)"
                            OnOpen="OpenServiceUsers" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="No daily note in 72 hours"
                            Value="@insights.MissingDailyNotes"
                            Description="Service users without a recent daily note."
                            Icon="bi bi-journal-x"
                            Severity="@GetWarningSeverity(insights.MissingDailyNotes)"
                            OnOpen="OpenServiceUsers" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Missing next of kin"
                            Value="@insights.MissingNextOfKin"
                            Description="Service users without a registered contact."
                            Icon="bi bi-person-exclamation"
                            Severity="@GetWarningSeverity(insights.MissingNextOfKin)"
                            OnOpen="OpenServiceUsers" />
                    </div>
                </div>
            }
        </section>

        <section>
            <div class="mb-3">
                <h3 class="mb-1">Quick actions</h3>

                <p class="text-muted mb-0">
                    Common actions for daily work.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-primary"
                   href="/serviceusers">
                    <i class="bi bi-people-fill me-1"></i>
                    View service users
                </a>

                <a class="btn btn-outline-primary"
                   href="/serviceusers">
                    <i class="bi bi-person-plus-fill me-1"></i>
                    Add service user
                </a>
            </div>
        </section>
    }
}

@code {
    private DashboardInsightsDto? insights;

    private bool isLoading = true;

    private string? errorMessage;

    private int TotalAttentionItems =>
        insights is null
            ? 0
            : insights.CarePlansOverdue +
              insights.CarePlansDueSoon +
              insights.MedicationWaiting +
              insights.MedicationMissed +
              insights.HighSeverityIncidents +
              insights.CalendarOverdue +
              insights.MissingDailyNotes +
              insights.MissingNextOfKin;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            isLoading = false;
            return;
        }

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;

        insights = await DashboardService.GetInsightsAsync();

        if (insights is null)
        {
            errorMessage =
                "Dashboard information could not be loaded.";
        }

        isLoading = false;
    }

    private async Task RefreshAsync()
    {
        await LoadDashboardAsync();
    }

    private void OpenServiceUsers()
    {
        Navigation.NavigateTo("/serviceusers");
    }

    private static string GetSeverity(int value)
    {
        return value > 0
            ? "danger"
            : "success";
    }

    private static string GetWarningSeverity(int value)
    {
        return value > 0
            ? "warning"
            : "success";
    }
}