@page "/"


@using SocialCareManager.Web.Components.Dashboard
@using SocialCareManager.Web.Dtos.Dashboard
@using SocialCareManager.Web.Services
@using SocialCareManager.Web.Services.Api

@inject DashboardService DashboardService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

@if (!AuthService.IsLoggedIn)
{
    <div class="alert alert-warning">
        Please sign in to access the dashboard.
    </div>

    <a class="btn btn-primary" href="/login">
        Go to login
    </a>
    
}
else
{
    <div class="dashboard-header mb-4">
        <div>
            <h1 class="dashboard-title">
                <i class="bi bi-speedometer2 me-2"></i>
                Dashboard
            </h1>

            <p class="dashboard-subtitle">
                Important information and actions across the care service.
            </p>
        </div>

        <button class="btn btn-outline-primary"
                @onclick="RefreshAsync"
                disabled="@isLoading">
            <i class="bi bi-arrow-clockwise"></i>
            @(isLoading ? "Refreshing..." : "Refresh")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-2"></i>
            @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="card p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="spinner-border text-primary"
                     role="status">
                </div>

                <div>
                    <strong>Loading dashboard</strong>

                    <div class="text-muted">
                        Collecting current information.
                    </div>
                </div>
            </div>
        </div>
    }
    else if (insights is not null)
    {
        <section class="mb-5">
            <div class="mb-3">
                <h3 class="mb-1">Overview</h3>

                <p class="text-muted mb-0">
                    Current totals across the system.
                </p>
            </div>

            <div class="row g-3">
                <div class="col-md-6 col-xl-3">
                    <button class="dashboard-stat-card"
                            @onclick="OpenServiceUsers">
                        <div class="dashboard-stat-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>

                        <div>
                            <div class="dashboard-stat-label">
                                Service users
                            </div>

                            <div class="dashboard-stat-value">
                                @insights.TotalServiceUsers
                            </div>
                        </div>
                    </button>
                </div>

                <div class="col-md-6 col-xl-3">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-icon">
                            <i class="bi bi-clipboard2-check-fill"></i>
                        </div>

                        <div>
                            <div class="dashboard-stat-label">
                                Active care plans
                            </div>

                            <div class="dashboard-stat-value">
                                @insights.ActiveCarePlans
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-3">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-icon">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>

                        <div>
                            <div class="dashboard-stat-label">
                                Open incidents
                            </div>

                            <div class="dashboard-stat-value">
                                @insights.OpenIncidents
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-3">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-icon">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>

                        <div>
                            <div class="dashboard-stat-label">
                                Events today
                            </div>

                            <div class="dashboard-stat-value">
                                @insights.CalendarToday
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-4">
            <div class="mb-3">
                <h3 class="mb-1">Needs attention</h3>

                <p class="text-muted mb-0">
                    Records and activities that may require follow-up.
                </p>
            </div>

            @if (TotalAttentionItems == 0)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    No urgent issues require attention.
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Care plans overdue"
                            Value="@insights.CarePlansOverdue"
                            Description="Active plans with a review date that has passed."
                            Icon="bi bi-clipboard-x"
                            Severity="@GetSeverity(insights.CarePlansOverdue)"
                            OnOpen="OpenCarePlansOverdueAsync" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Care plans due soon"
                            Value="@insights.CarePlansDueSoon"
                            Description="Care plans due for review within seven days."
                            Icon="bi bi-calendar2-week"
                            Severity="@GetWarningSeverity(insights.CarePlansDueSoon)"
                            OnOpen="OpenCarePlansDueSoonAsync" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Medication doses waiting"
                            Value="@insights.MedicationWaiting"
                            Description="Medication doses that have not yet been recorded."
                            Icon="bi bi-capsule"
                            Severity="@GetSeverity(insights.MedicationWaiting)"
                            OnOpen="OpenMedicationWaitingAsync" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Medication not given"
                            Value="@insights.MedicationMissed"
                            Description="Refused, omitted or unavailable medication doses."
                            Icon="bi bi-capsule-pill"
                            Severity="@GetSeverity(insights.MedicationMissed)"
                            OnOpen="OpenMedicationMissedAsync" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="High-severity incidents"
                            Value="@insights.HighSeverityIncidents"
                            Description="Open incidents marked high or critical."
                            Icon="bi bi-exclamation-octagon-fill"
                            Severity="@GetSeverity(insights.HighSeverityIncidents)"
                            OnOpen="OpenHighIncidentsAsync" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Calendar events overdue"
                            Value="@insights.CalendarOverdue"
                            Description="Scheduled activities whose end time has passed."
                            Icon="bi bi-calendar-x"
                            Severity="@GetSeverity(insights.CalendarOverdue)"
                            OnOpen="OpenCalendarOverdueAsync" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="No daily note in 72 hours"
                            Value="@insights.MissingDailyNotes"
                            Description="Service users without a recent daily note."
                            Icon="bi bi-journal-x"
                            Severity="@GetWarningSeverity(insights.MissingDailyNotes)"
                            OnOpen="OpenMissingDailyNotesAsync" />
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <InsightCard
                            Title="Missing next of kin"
                            Value="@insights.MissingNextOfKin"
                            Description="Service users without a registered contact."
                            Icon="bi bi-person-exclamation"
                            Severity="@GetWarningSeverity(insights.MissingNextOfKin)"
                            OnOpen="OpenMissingNextOfKinAsync" />
                    </div>
                </div>
            }
        </section>

        @if (selectedAttentionType is not null)
        {
            <section class="mb-5">
                <DashboardAttentionList
                    Title="@selectedAttentionTitle"
                    Items="attentionItems"
                    IsLoading="isLoadingAttention"
                    OnOpen="OpenAttentionItem"
                    OnClose="CloseAttention" />
            </section>
        }

        <section class="mb-5">
            <DashboardActivityFeed
                Activities="activities"
                IsLoading="isLoadingActivity"
                OnOpen="OpenActivity" />
        </section>

        <section class="mb-4">
            <div class="mb-3">
                <h3 class="mb-1">Quick actions</h3>

                <p class="text-muted mb-0">
                    Common actions for daily work.
                </p>
            </div>

            <div class="row g-3">
                <div class="col-md-6 col-xl-3">
                    <a class="quick-action-card"
                       href="/serviceusers">
                        <i class="bi bi-people-fill"></i>

                        <div>
                            <strong>Service users</strong>
                            <span>View all care records</span>
                        </div>
                    </a>
                </div>

                <div class="col-md-6 col-xl-3">
                    <a class="quick-action-card"
                       href="/serviceusers">
                        <i class="bi bi-person-plus-fill"></i>

                        <div>
                            <strong>Add service user</strong>
                            <span>Create a new profile</span>
                        </div>
                    </a>
                </div>

                <div class="col-md-6 col-xl-3">
                    <a class="quick-action-card"
                       href="/serviceusers">
                        <i class="bi bi-journal-plus"></i>

                        <div>
                            <strong>Write daily note</strong>
                            <span>Select a service user</span>
                        </div>
                    </a>
                </div>

                <div class="col-md-6 col-xl-3">
                    <a class="quick-action-card"
                       href="/serviceusers">
                        <i class="bi bi-exclamation-triangle"></i>

                        <div>
                            <strong>Report incident</strong>
                            <span>Select a service user</span>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    }
}

@code {
    private DashboardInsightsDto? insights;

    private List<DashboardAttentionItemDto> attentionItems = new();

    private List<DashboardActivityDto> activities = new();

    private string? selectedAttentionType;

    private string selectedAttentionTitle = string.Empty;

    private bool isLoading = true;

    private bool isLoadingAttention;

    private bool isLoadingActivity;

    private string? errorMessage;

    private int TotalAttentionItems =>
        insights is null
            ? 0
            : insights.CarePlansOverdue +
              insights.CarePlansDueSoon +
              insights.MedicationWaiting +
              insights.MedicationMissed +
              insights.HighSeverityIncidents +
              insights.CalendarOverdue +
              insights.MissingDailyNotes +
              insights.MissingNextOfKin;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            isLoading = false;
            return;
        }

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        isLoadingActivity = true;
        errorMessage = null;

        try
        {
            insights =
                await DashboardService.GetInsightsAsync();

            activities =
                await DashboardService.GetActivityAsync(12);

            if (insights is null)
            {
                errorMessage =
                    "Dashboard information could not be loaded.";
            }

            if (selectedAttentionType is not null)
            {
                attentionItems =
                    await DashboardService.GetAttentionItemsAsync(
                        selectedAttentionType);
            }
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Dashboard information could not be loaded. Check that the API is running.";
        }
        finally
        {
            isLoadingActivity = false;
            isLoading = false;
        }
    }

    private async Task RefreshAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task OpenAttentionAsync(
        string type,
        string title)
    {
        selectedAttentionType = type;
        selectedAttentionTitle = title;
        isLoadingAttention = true;
        errorMessage = null;
        attentionItems.Clear();

        try
        {
            attentionItems =
                await DashboardService.GetAttentionItemsAsync(type);
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "The selected dashboard details could not be loaded.";
        }
        finally
        {
            isLoadingAttention = false;
        }
    }

    private Task OpenCarePlansOverdueAsync()
    {
        return OpenAttentionAsync(
            "careplans-overdue",
            "Care plans overdue");
    }

    private Task OpenCarePlansDueSoonAsync()
    {
        return OpenAttentionAsync(
            "careplans-due-soon",
            "Care plans due soon");
    }

    private Task OpenMedicationWaitingAsync()
    {
        return OpenAttentionAsync(
            "medication-waiting",
            "Medication doses waiting");
    }

    private Task OpenMedicationMissedAsync()
    {
        return OpenAttentionAsync(
            "medication-missed",
            "Medication not given");
    }

    private Task OpenHighIncidentsAsync()
    {
        return OpenAttentionAsync(
            "high-incidents",
            "High-severity incidents");
    }

    private Task OpenCalendarOverdueAsync()
    {
        return OpenAttentionAsync(
            "calendar-overdue",
            "Calendar events overdue");
    }

    private Task OpenMissingDailyNotesAsync()
    {
        return OpenAttentionAsync(
            "missing-daily-notes",
            "No daily note in 72 hours");
    }

    private Task OpenMissingNextOfKinAsync()
    {
        return OpenAttentionAsync(
            "missing-next-of-kin",
            "Missing next of kin");
    }

    private void CloseAttention()
    {
        selectedAttentionType = null;
        selectedAttentionTitle = string.Empty;
        attentionItems.Clear();
    }

    private void OpenAttentionItem(
        DashboardAttentionItemDto item)
    {
        Navigation.NavigateTo(
            $"/serviceusers/{item.ServiceUserId}" +
            $"?tab={item.TargetTab}");
    }

    private void OpenActivity(
        DashboardActivityDto activity)
    {
        Navigation.NavigateTo(
            $"/serviceusers/{activity.ServiceUserId}" +
            $"?tab={activity.TargetTab}");
    }

    private void OpenServiceUsers()
    {
        Navigation.NavigateTo("/serviceusers");
    }

    private static string GetSeverity(int value)
    {
        return value > 0
            ? "danger"
            : "success";
    }

    private static string GetWarningSeverity(int value)
    {
        return value > 0
            ? "warning"
            : "success";
    }
}