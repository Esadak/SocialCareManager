@using SocialCareManager.Web.Dtos.Dashboard

<div class="card p-4 h-100">
    <div class="mb-3">
        <h4 class="mb-1">
            <i class="bi bi-activity me-2"></i>
            Recent activity
        </h4>

        <p class="text-muted mb-0">
            Latest changes across the system.
        </p>
    </div>

    @if (IsLoading)
    {
        <p>Loading recent activity...</p>
    }
    else if (Activities.Count == 0)
    {
        <p class="text-muted mb-0">
            No recent activity was found.
        </p>
    }
    else
    {
        <div class="dashboard-activity-list">
            @foreach (var activity in Activities)
            {
                <button class="dashboard-activity-item"
                        @onclick="() => OnOpen.InvokeAsync(activity)">
                    <div class="dashboard-activity-icon">
                        <i class="@activity.Icon"></i>
                    </div>

                    <div class="flex-grow-1 text-start">
                        <div class="fw-semibold">
                            @activity.Title
                        </div>

                        <div class="small">
                            @activity.ServiceUserName
                            · @activity.ActivityType
                        </div>

                        <div class="small text-muted">
                            @activity.Description
                        </div>

                        <div class="small text-muted mt-1">
                            @(activity.OccurredAt
                                .ToLocalTime()
                                .ToString("yyyy-MM-dd HH:mm"))

                            @if (!string.IsNullOrWhiteSpace(activity.PerformedBy))
                            {
                                <span>
                                    · @activity.PerformedBy
                                </span>
                            }
                        </div>
                    </div>

                    <i class="bi bi-chevron-right text-muted"></i>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public List<DashboardActivityDto> Activities { get; set; } = new();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<DashboardActivityDto> OnOpen { get; set; }
}