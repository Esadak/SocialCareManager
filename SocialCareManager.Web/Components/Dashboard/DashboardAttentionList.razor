@using SocialCareManager.Web.Dtos.Dashboard

<div class="card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h4 class="mb-1">@Title</h4>

            <p class="text-muted mb-0">
                @Items.Count record(s) require attention.
            </p>
        </div>

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="OnClose">
            <i class="bi bi-x-lg"></i>
            Close
        </button>
    </div>

    @if (IsLoading)
    {
        <p>Loading details...</p>
    }
    else if (Items.Count == 0)
    {
        <div class="alert alert-success mb-0">
            No matching records were found.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var item in Items)
            {
                <button class="list-group-item list-group-item-action p-3"
                        @onclick="() => OnOpen.InvokeAsync(item)">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <div class="fw-semibold">
                                @item.ServiceUserName
                            </div>

                            <div class="mt-1">
                                @item.Title
                            </div>

                            <div class="small text-muted mt-1">
                                @item.Description
                            </div>

                            @if (item.RelevantAt.HasValue)
                            {
                                <div class="small text-muted mt-2">
                                    @(item.RelevantAt.Value
                                        .ToLocalTime()
                                        .ToString("yyyy-MM-dd HH:mm"))
                                </div>
                            }
                        </div>

                        <i class="bi bi-chevron-right"></i>
                    </div>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public List<DashboardAttentionItemDto> Items { get; set; } = new();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<DashboardAttentionItemDto> OnOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }
}