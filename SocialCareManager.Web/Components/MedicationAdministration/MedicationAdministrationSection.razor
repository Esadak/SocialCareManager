@using SocialCareManager.Web.Components.Common
@using SocialCareManager.Web.Dtos
@using SocialCareManager.Web.Services.Api
@inject MedicationAdministrationService AdministrationService
@inject MedicationService MedicationService

<div class="section-card">
    <ActionToolbar
        Title="Medication doses"
        Subtitle="Plan and record each medication dose.">

        <Actions>
            @if (medications.Count > 0)
            {
                <button class="btn btn-primary"
                        @onclick="OpenCreateForm">
                    <i class="bi bi-plus-circle"></i>
                    Plan dose
                </button>
            }
        </Actions>
    </ActionToolbar>

    @if (medications.Count == 0 && !isLoading)
    {
        <div class="alert alert-warning">
            Add a medication before planning a dose.
        </div>
    }

    @if (showCreateForm)
    {
        <MedicationAdministrationForm
            Administration="newAdministration"
            Medications="medications"
            OnSave="CreateAdministrationAsync"
            OnCancel="CloseCreateForm" />
    }

    @if (administrationToRecord is not null)
    {
        <MedicationAdministrationRecordForm
            Administration="administrationToRecord"
            Record="recordAdministration"
            OnSave="SaveRecordAsync"
            OnCancel="CancelRecording" />
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <p>Loading medication doses...</p>
    }
    else
    {
        <MedicationAdministrationList
            Administrations="administrations"
            OnRecord="StartRecording" />
    }
</div>

@code {
    [Parameter]
    public Guid ServiceUserId { get; set; }

    private List<MedicationDto> medications = new();
    private List<MedicationAdministrationDto> administrations = new();

    private CreateMedicationAdministrationDto newAdministration = new();
    private RecordMedicationAdministrationDto recordAdministration = new();

    private MedicationAdministrationDto? administrationToRecord;

    private bool isLoading = true;
    private bool showCreateForm;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        medications = await MedicationService.GetAllAsync(ServiceUserId);

        administrations =
            await AdministrationService.GetAllAsync(ServiceUserId);

        isLoading = false;
    }

    private void OpenCreateForm()
    {
        errorMessage = null;
        administrationToRecord = null;

        newAdministration = new CreateMedicationAdministrationDto
        {
            ScheduledAt = DateTime.Now
        };

        showCreateForm = true;
    }

    private void CloseCreateForm()
    {
        errorMessage = null;
        showCreateForm = false;
        newAdministration = new CreateMedicationAdministrationDto();
    }

    private async Task CreateAdministrationAsync()
    {
        errorMessage = null;

        if (newAdministration.MedicationId == Guid.Empty)
        {
            errorMessage = "Select a medication.";
            return;
        }

        var created = await AdministrationService.CreateAsync(
            ServiceUserId,
            newAdministration);

        if (created is null)
        {
            errorMessage = "The medication dose could not be planned.";
            return;
        }

        CloseCreateForm();
        await LoadDataAsync();
    }

    private void StartRecording(
        MedicationAdministrationDto administration)
    {
        errorMessage = null;
        showCreateForm = false;

        administrationToRecord = administration;

        recordAdministration = new RecordMedicationAdministrationDto
        {
            Status = MedicationAdministrationStatus.Pending,
            AdministeredAt = DateTime.Now
        };
    }

    private void CancelRecording()
    {
        errorMessage = null;
        administrationToRecord = null;
        recordAdministration = new RecordMedicationAdministrationDto();
    }

    private async Task SaveRecordAsync()
    {
        errorMessage = null;

        if (administrationToRecord is null)
            return;

        if (recordAdministration.Status ==
            MedicationAdministrationStatus.Pending)
        {
            errorMessage = "Select what happened with the medication dose.";
            return;
        }

        if (RequiresReason(recordAdministration.Status) &&
            string.IsNullOrWhiteSpace(recordAdministration.Reason))
        {
            errorMessage = "Enter a reason for the selected status.";
            return;
        }

        var recorded = await AdministrationService.RecordAsync(
            ServiceUserId,
            administrationToRecord.Id,
            recordAdministration);

        if (!recorded)
        {
            errorMessage = "The medication dose could not be recorded.";
            return;
        }

        CancelRecording();
        await LoadDataAsync();
    }

    private static bool RequiresReason(
        MedicationAdministrationStatus status)
    {
        return status == MedicationAdministrationStatus.Refused ||
               status == MedicationAdministrationStatus.Delayed ||
               status == MedicationAdministrationStatus.Omitted ||
               status == MedicationAdministrationStatus.NotAvailable;
    }
}