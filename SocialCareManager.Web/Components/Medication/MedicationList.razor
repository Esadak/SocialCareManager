@using SocialCareManager.Web.Services.Api
@using SocialCareManager.Web.Dtos
@using SocialCareManager.Web.Components.Common

@if (Medications.Count == 0)
{
    <EmptyState
        Icon="bi bi-capsule"
        Title="No medication added"
        Description="This person doesn't have any registered medication yet."
        ShowButton="true"
        ButtonText="Add medication"
        ButtonIcon="bi bi-plus-circle"
        OnButtonClick="OnAdd" />
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Strength</th>
                <th>Dose</th>
                <th>How often</th>
                <th>How to take</th>
                <th>Start</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var medication in Medications)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@medication.Name</div>

                        <div class="small text-muted">
                            Created @FormatDate(medication.CreatedAt)
                            by @DisplayUser(medication.CreatedBy)
                        </div>

                        @if (medication.UpdatedAt.HasValue)
                        {
                            <div class="small text-muted">
                                Updated @FormatDate(medication.UpdatedAt.Value)
                                by @DisplayUser(medication.UpdatedBy)
                            </div>
                        }
                    </td>

                    <td>@medication.Strength</td>
                    <td>@medication.Dosage</td>
                    <td>@medication.Frequency</td>
                    <td>@medication.Route</td>
                    <td>@medication.StartDate.ToShortDateString()</td>

                    <td>
                        @if (medication.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>

                    <td>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OnEdit.InvokeAsync(medication)">
                                <i class="bi bi-pencil"></i>
                                Edit
                            </button>

                            @if (CanDelete)
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => OnDelete.InvokeAsync(medication)">
                                    <i class="bi bi-trash"></i>
                                    Delete
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public List<MedicationDto> Medications { get; set; } = new();

    [Parameter]
    public bool CanDelete { get; set; }

    [Parameter]
    public EventCallback OnAdd { get; set; }

    [Parameter]
    public EventCallback<MedicationDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<MedicationDto> OnDelete { get; set; }

    private string FormatDate(DateTime date)
    {
        return date == default
            ? "not available"
            : date.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

    private string DisplayUser(string? user)
    {
        return string.IsNullOrWhiteSpace(user)
            ? "System"
            : user;
    }
}